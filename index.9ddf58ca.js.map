"use strict";
var gallery = document.querySelector("div.gallery");
var mainCanvaBlock = gallery.firstElementChild;
var list = gallery.querySelector("ul");
list.addEventListener("click", function(info) {
    info.preventDefault();
    var link = info.target.closest("a");
    if (!link) return;
    var ref = link.getAttribute("href");
    mainCanvaBlock.querySelector("img").setAttribute("src", ref);
});

